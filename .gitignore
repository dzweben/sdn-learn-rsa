# OS and editor cruft
.DS_Store
**/.DS_Store
**/._*
~$*

# Python
__pycache__/
**/__pycache__/
*.pyc

# Local virtualenvs (guides/pi-walkthrough builds one)
**/.venv/

# Study data lives on the clusters, not in git.
# The README inside each of these directories IS tracked, as a map to what is there.
bids_fixed/*
!bids_fixed/README.md
TimingFiles/Fixed2/*
!TimingFiles/Fixed2/README.md
derivatives/*
!derivatives/README.md

# Local-only symlink to the raw data share
fmri-data/

# Secrets, never commit
*.token
.osf_token
.secrets/

# Scratch
*.log
.tmp_rerun/
